# Mật khẩu đăng nhập web panel
ADMIN_PASSWORD=doi-mat-khau-nay
# Khoá ký cookie: chạy `openssl rand -hex 32` để tạo
SESSION_SECRET=
PORT=3000
# Đặt true khi chạy sau HTTPS (Caddy/Nginx)
SECURE_COOKIE=false
# Thư mục lưu DB + phiên Zalo (mặc định ./data)
# DATA_DIR=data
# Proxy cho Zalo khi chạy trên VPS (để tránh IP datacenter bị Zalo chặn).
# HTTP proxy:  ZALO_PROXY=http://user:pass@proxy-host:8080
# SOCKS5 proxy (SSH tunnel): ZALO_PROXY=socks5://127.0.0.1:1080
# ZALO_PROXY=
