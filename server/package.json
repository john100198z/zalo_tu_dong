{
  "name": "zalo-autoreply-server",
  "version": "1.0.0",
  "scripts": {
    "test": "tsx --test 'src/**/*.test.ts'",
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "build": "tsc -p .",
    "start": "node --env-file-if-exists=../.env dist/index.js",
    "typecheck": "tsc -p . --noEmit"
  },
  "type": "module",
  "dependencies": {
