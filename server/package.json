    "@fastify/websocket": "^11.3.7",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.8",
    "pino-pretty": "^13.2.0",
    "undici": "^7.30.2",
    "zca-js": "^2.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
